---
import Base from '../../layouts/Base.astro';
import { getKind, urlOf, fmtDate } from '../../lib/content';
const projects = await getKind('projects');
---
<Base title="Projects" description="Things I have built and studied.">
  <div class="kicker">Work</div>
  <h1>Projects</h1>
  <p class="lede">Course projects, experiments and side builds.</p>
  <div class="grid">
    {projects.map((p) => (
      <div class="card">
        <div class="kicker">{fmtDate(p.data.date)}</div>
        <a class="t" href={urlOf(p)}>{p.data.title}</a>
        {p.data.description && <p>{p.data.description}</p>}
      </div>
    ))}
  </div>
</Base>
